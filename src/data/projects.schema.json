{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Projets du portfolio",
  "description": "Liste des dépôts affichés dans le Hub Outils. Un objet = une carte.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "status", "category", "problem", "solution", "repo"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "description": "Identifiant unique, en minuscules (ex. « tram-radar »)." },
      "name": { "type": "string", "description": "Nom affiché du projet." },
      "tagline": { "type": "string", "description": "Une phrase d'accroche sous le nom." },
      "status": {
        "enum": ["production", "beta", "en-cours", "prototype", "archive"],
        "description": "Badge de statut."
      },
      "category": { "type": "string", "description": "Catégorie principale, sert au filtre (ex. « Mobilité »)." },
      "tags": { "type": "array", "items": { "type": "string" }, "description": "Mots-clés techniques, cliquables pour filtrer." },
      "featured": { "type": "boolean", "description": "true = carte mise en avant, affichée en premier." },
      "year": { "type": "integer" },
      "version": { "type": "string", "description": "Version courante, ex. « 4.6.13 »." },
      "problem": { "type": "string", "description": "Cas d'usage métier / problème concret résolu." },
      "solution": { "type": "string", "description": "Idée directrice de la solution." },
      "architecture": { "type": "array", "items": { "type": "string" }, "description": "Choix d'architecture, une puce par ligne." },
      "ai": { "type": "array", "items": { "type": "string" }, "description": "Modèles d'IA utilisés par le produit lui-même (ex. « Claude Sonnet »)." },
      "apis": { "type": "array", "items": { "type": "string" }, "description": "API et services externes mobilisés." },
      "builtWith": { "type": "array", "items": { "type": "string" }, "description": "Outils d'IA utilisés pour concevoir/coder le projet (ex. « Claude Code »)." },
      "highlights": { "type": "array", "items": { "type": "string" }, "description": "Chiffres ou faits marquants, courts." },
      "repo": { "type": "string", "format": "uri", "description": "URL du dépôt GitHub." },
      "repoPrivate": { "type": "boolean", "description": "true = dépôt privé : le lien est remplacé par un badge « Code privé »." },
      "demo": { "type": ["string", "null"], "format": "uri", "description": "Lien de démonstration, ou null." },
      "demoLabel": { "type": "string", "description": "Libellé du bouton de démo (défaut : « Démo »)." },
      "image": { "type": "string", "description": "URL d'une capture d'écran (optionnel)." }
    }
  }
}
